load("@aspect_rules_ts//ts:defs.bzl", "ts_project")

package(default_visibility = ["//visibility:public"])

ts_project(
    name = "tap-protocol",
    srcs = glob(
        [
            "src/**/*.ts",
        ],
        allow_empty = False,
    ),
    declaration = True,
    declaration_map = True,
    source_map = True,
    tsconfig = "tsconfig.json",
)

